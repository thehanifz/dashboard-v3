# Vite Frontend Environment Variables
# Copy file ini ke .env.local dan sesuaikan nilainya

# App info — fallback jika settings DB belum ada key ini
# Nilai sebenarnya diambil dari database via /api/settings/public
VITE_APP_NAME=OverSee
VITE_APP_SUBTITLE=PA PLN ICONPLUS
VITE_APP_VERSION=3.2

# API Base URL (biasanya tidak perlu diubah karena pakai Vite proxy)
# VITE_API_BASE_URL=/api

# Nama kolom status di tabel utama
# Harus sama persis dengan nama kolom di database/Google Sheet
VITE_STATUS_COL_PRIMARY=Status Pekerjaan
VITE_STATUS_COL_DETAIL=Detail Progres
